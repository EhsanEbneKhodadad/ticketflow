# Local development only. Copy to .env. Never use these values on a public host.
POSTGRES_DB=ticketflow
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow_local_only
S3_ACCESS_KEY_ID=ticketflow
S3_SECRET_ACCESS_KEY=ticketflow_storage_local_only

# Explicit local demo personas only; never seed these on a public host.
DEMO_PASSWORD=TicketFlowDemo!2026

# Optional public-ticket search; start Compose with --profile search when enabled.
SEARCH_ENABLED=false
